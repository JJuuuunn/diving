# Medical hospital list Google Apps Script Web App URL
VITE_MEDICAL_GOOGLE_APPS_SCRIPT_API_URL=your_medical_google_apps_script_url_here

# Competition list/status Google Apps Script Web App URL
VITE_COMPETITION_GOOGLE_APPS_SCRIPT_API_URL=your_competition_google_apps_script_url_here

# Server-only secret shared by GitHub Actions and the competition Apps Script
COMPETITION_INGEST_SECRET=replace_with_a_long_random_secret

# Kakao Map Javascript API Key (from developers.kakao.com)
VITE_KAKAO_MAP_API_KEY=your_kakao_map_api_key_here
