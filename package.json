{
  "name": "diving-pool-vue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "sync:competitions": "node scripts/sync-competitions.mjs",
    "validate:competitions": "node scripts/sync-competitions.mjs --validate-only",
    "ingest:aida": "node --env-file-if-exists=.env.local scripts/scrape-aida.mjs",
    "test": "node --test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@vueuse/core": "^14.2.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.20",
    "html-to-image": "^1.11.13",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "sass": "^1.97.2",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
